---
// Página de um post: /blog/<slug>/
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { AUTHOR_ID, AUTHOR_NAME, AUTHOR_URL, BLOG_NAME, EMAIL_LIST_NAME, NEWSLETTER_FORM_ENABLED, WEBSITE_ID } from '../consts';
import { absoluteUrl, formatDate, postLdGraph, postPath, spotifyEmbedUrl, withBase } from '../lib/blog';
import { sortedPosts, type Post } from '../lib/posts';
import CtaLine from '../components/CtaLine.astro';
import { CTA_LOCATION_END, relatedPosts, topicById, topicPath, topicProblems } from '../lib/topics';

export async function getStaticPaths() {
  const all = await sortedPosts();
  // Temas (#104): o build falha com post do tema fora da ordem de leitura, tema com menos de 5 posts etc.
  const problems = topicProblems(all);
  if (problems.length) throw new Error(`temas do blog (src/lib/topics.ts):\n${problems.join('\n')}`);
  return all.map((post) => ({ params: { slug: post.id }, props: { post, related: relatedPosts(post, all) } }));
}

interface Props {
  post: Post;
  // Posts do bloco "Leia também"; vazio nos podcasts e nos posts fora do índice, que ficam sem o bloco.
  related: Post[];
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const base = import.meta.env.BASE_URL;
const site = Astro.site!.href;
const url = absoluteUrl(site, Astro.url.pathname);
const coverPath = d.cover ? withBase(base, d.cover) : undefined;
const coverUrl = coverPath ? absoluteUrl(site, coverPath) : undefined;
const embed = d.spotify_url ? spotifyEmbedUrl(d.spotify_url) : null;
const topic = d.topics?.[0] ? topicById(d.topics[0]) : undefined;
const updatedShown = d.updated && formatDate(d.updated) !== formatDate(d.date);
// JSON-LD (#105): BlogPosting, trilha Home > Blog > título (com os nomes que a página mostra no menu e na trilha)
// e a Person mínima. O check_site falha se um post indexável sair sem esse @graph.
const ld = postLdGraph({
  title: d.title,
  description: d.description,
  date: d.date,
  updated: d.updated,
  url,
  image: coverUrl,
  author: { id: AUTHOR_ID, name: AUTHOR_NAME, url: AUTHOR_URL },
  websiteId: WEBSITE_ID,
  crumbs: [
    { name: AUTHOR_NAME, url: AUTHOR_URL },
    { name: BLOG_NAME, url: absoluteUrl(site, base) },
  ],
});
---
<Base title={d.title} contentGroup="insights-artigo" description={d.description} index={d.index} image={coverUrl} ogType="article" jsonLd={ld} turnstile={NEWSLETTER_FORM_ENABLED}>
  <article class="post">
    <header class="post-head">
      <p class="post-crumb"><a href={base}>{BLOG_NAME}</a>{topic && <> <span aria-hidden="true">/</span> <a href={topicPath(base, topic.id)}>{topic.short}</a></>}</p>
      <h1>{d.title}</h1>
      {d.subtitle && <p class="post-sub">{d.subtitle}</p>}
      <p class="post-meta">
        <span>{AUTHOR_NAME}</span>{' '}&middot;{' '}
        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
        {updatedShown && d.updated && (
          <span>{' '}&middot; atualizado em <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time></span>
        )}
      </p>
    </header>
    {d.type === 'podcast' && embed && (
      <div class="podcast-embed">
        <iframe src={embed} title={`Episódio: ${d.title}`} height="102" loading="lazy" allow="encrypted-media" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
    )}
    <div class="post-body">
      <Content />
    </div>
    {related.length > 0 && (
      <aside class="related" aria-label="Leia também">
        {topic ? <h2>Mais artigos sobre <a href={topicPath(base, topic.id)}>{topic.about}</a></h2> : <h2>Leia também</h2>}
        <ul>
          {related.map((r) => <li><a href={postPath(base, r.id)}>{r.data.title}</a></li>)}
        </ul>
        {topic?.blockCta && <p class="related-cta"><CtaLine parts={topic.blockCta} location={CTA_LOCATION_END} /></p>}
      </aside>
    )}
    {NEWSLETTER_FORM_ENABLED && (
      <aside class="subscribe" id="assinar" aria-label="Inscrição por email">
        <h2>{EMAIL_LIST_NAME}: receba os próximos artigos por email</h2>
        <SubscribeForm />
      </aside>
    )}
  </article>
</Base>
