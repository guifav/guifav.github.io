---
// Página da newsletter (issue #21). Fora do sitemap e sempre com noindex.
import Base from '../layouts/Base.astro';
import { AUTHOR_NAME, BLOG_NAME, EMAIL_LIST_NAME } from '../consts';

const base = import.meta.env.BASE_URL;
---
<Base title={`${EMAIL_LIST_NAME}: inscrição confirmada | ${AUTHOR_NAME}`} contentGroup="expert-insights" description={`Inscrição nos ${EMAIL_LIST_NAME} confirmada.`} index={false}>
  <article class="post page" data-ga-event="sign_up">
    <header class="post-head">
      <p class="post-crumb"><a href={base}>{BLOG_NAME}</a></p>
      <h1>Inscrição confirmada</h1>
    </header>
    <div class="post-body">
      <p>Pronto: você vai receber os {EMAIL_LIST_NAME}, um email a cada artigo novo, enviado de insights@expert.guifav.dev. Todo email traz um link para sair da lista.</p>
      <p><a href={base}>Ver os artigos</a></p>
    </div>
  </article>
</Base>
