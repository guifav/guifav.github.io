---
// Página da newsletter (issue #21). Fora do sitemap e sempre com noindex.
import Base from '../layouts/Base.astro';
import { AUTHOR_NAME } from '../consts';

const base = import.meta.env.BASE_URL;
---
<Base title={`Inscrição confirmada | ${AUTHOR_NAME}`} description="Inscrição na IA Aplicada confirmada." index={false}>
  <article class="post page">
    <header class="post-head">
      <p class="post-crumb"><a href={base}>Blog</a></p>
      <h1>Inscrição confirmada</h1>
    </header>
    <div class="post-body">
      <p>Pronto: você vai receber a IA Aplicada a cada artigo novo. Todo email traz um link para sair da lista.</p>
      <p><a href={base}>Ver os artigos do blog</a></p>
    </div>
  </article>
</Base>
